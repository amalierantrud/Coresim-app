<!-- Avvik: trafikk som skiller seg fra baselinen.
     Pakkene telles per strøm per 10 sekunder, og kommandoen finnavvik (bin/finnavvik.py og bin/deteksjon.py)
     sammenligner hvert vindu med lookups/baseline_trafikk.csv. Reglene og grensene er forklart i README.
     Pakkene hentes med makroen ot_data (macros.conf), så samme dashboard virker lokalt og på coresim. -->
<dashboard version="1.1" script="lukkbar.js">
  <label>Avvik</label>

  <!-- Felles søk for alle panelene, så dashboardet bare kjører ett søk.
       Tar med alle pakker med port og lengde, også HSRP, som er UDP men har egen protokoll. -->
  <search id="avvik">
    <query>`ot_data` src_ip=* dst_port=* len=*
| bin _time span=10s
| stats count AS n values(src_mac) AS src_mac by _time src_ip dst_ip dst_port len
| eval src_mac=mvjoin(src_mac, " ")
| finnavvik</query>
    <earliest>$tid.earliest$</earliest>
    <latest>$tid.latest$</latest>
  </search>

  <!-- Tidsvelger og filter på type. Tallene øverst viser alltid alle typer, resten følger filteret. -->
  <fieldset submitButton="false">
    <input type="time" token="tid">
      <label>Tidsrom</label>
      <default>
        <earliest>0</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="type">
      <label>Type avvik</label>
      <choice value="*">Alle</choice>
      <choice value="Feil MAC">Feil MAC</choice>
      <choice value="For høy rate">For høy rate</choice>
      <choice value="For lav rate">For lav rate</choice>
      <choice value="Ny strøm">Ny strøm</choice>
      <choice value="Strøm mangler">Strøm mangler</choice>
      <default>*</default>
    </input>
  </fieldset>

  <!-- Ett tall per type: antall 10-sekundersvinduer med avvik. Grønn ved 0, rød ellers. -->
  <row>
    <panel>
      <title>Feil MAC</title>
      <single>
        <search base="avvik">
          <query>stats count(eval(type=="Feil MAC")) AS avvik</query>
        </search>
        <option name="useColors">1</option>
        <option name="colorBy">value</option>
        <option name="rangeValues">[0]</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
      </single>
    </panel>
    <panel>
      <title>For høy rate</title>
      <single>
        <search base="avvik">
          <query>stats count(eval(type=="For høy rate")) AS avvik</query>
        </search>
        <option name="useColors">1</option>
        <option name="colorBy">value</option>
        <option name="rangeValues">[0]</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
      </single>
    </panel>
    <panel>
      <title>For lav rate</title>
      <single>
        <search base="avvik">
          <query>stats count(eval(type=="For lav rate")) AS avvik</query>
        </search>
        <option name="useColors">1</option>
        <option name="colorBy">value</option>
        <option name="rangeValues">[0]</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
      </single>
    </panel>
    <panel>
      <title>Ny strøm</title>
      <single>
        <search base="avvik">
          <query>stats count(eval(type=="Ny strøm")) AS avvik</query>
        </search>
        <option name="useColors">1</option>
        <option name="colorBy">value</option>
        <option name="rangeValues">[0]</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
      </single>
    </panel>
    <panel>
      <title>Strøm mangler</title>
      <single>
        <search base="avvik">
          <query>stats count(eval(type=="Strøm mangler")) AS avvik</query>
        </search>
        <option name="useColors">1</option>
        <option name="colorBy">value</option>
        <option name="rangeValues">[0]</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
      </single>
    </panel>
  </row>

  <!-- Diagnose: avvikene i samme vindu tolkes som mulige angrep av kommandoen diagnoser (bin/deteksjon.py).
       Navn, alvorlighet og MITRE-nummer hentes fra lookups/angrepstyper.csv.
       Forklaring, tiltak og MITRE sine tiltak vises på siden Detaljer.
       Viser alle typer avvik, uavhengig av filteret på type.
       Tabellen viser bare oversikten (<fields>). Klikk en rad for å se forklaring, tiltak og trafikken på siden Detaljer.
       Panelet er lukket til man trykker på pilen ved overskriften (appserver/static/lukkbar.js). Lukket viser det antallet. -->
  <search base="avvik">
    <query>diagnoser
| lookup angrepstyper.csv angrep OUTPUT navn alvorlighet
| fillnull value="-" strom
| stats first(alvorlighet) AS alvorlighet by navn strom
| stats count AS antall count(eval(alvorlighet=="Høy")) AS hoy</query>
    <done>
      <set token="n_angrep">$result.antall$</set>
      <set token="n_hoy">$result.hoy$</set>
    </done>
  </search>
  <row>
    <panel id="lukkbar_angrep">
      <title>Mulige angrep</title>
      <html rejects="$vis_angrep$">
        <p class="lukkbar-hint" style="cursor: pointer; margin: 0;">
          <b>$n_angrep$</b> mulige angrep, <b>$n_hoy$</b> med høy alvorlighet. Trykk på pilen for å vise dem.
        </p>
      </html>
      <html depends="$vis_angrep$">
        <p style="margin: 0;">Klikk en rad for detaljer.</p>
      </html>
      <table depends="$vis_angrep$">
        <search base="avvik">
          <query>diagnoser
| lookup angrepstyper.csv angrep OUTPUT navn alvorlighet rekkefolge mitre_id mitre_navn
| fillnull value="-" strom
| stats count AS vinduer min(_time) AS forste max(_time) AS siste values(src_ip) AS avsendere
    first(alvorlighet) AS alvorlighet first(rekkefolge) AS rekkefolge first(mitre_id) AS mitre_id first(mitre_navn) AS mitre_navn
    by navn strom
| sort rekkefolge -vinduer
| eval mitre=mitre_id." ".mitre_navn, id=navn, velg=if(strom=="-", "Alt fra ".mvindex(avsendere, 0), strom),
    vis_fra=forste - 300, vis_til=siste + 300, forste=strftime(forste, "%d.%m %H:%M:%S"), siste=strftime(siste, "%d.%m %H:%M:%S")
| table navn alvorlighet strom avsendere vinduer forste siste mitre id velg vis_fra vis_til
| rename navn AS "Mulig angrep", alvorlighet AS "Alvorlighet", strom AS "Strøm", avsendere AS "Avsender",
    vinduer AS "Vinduer", forste AS "Første", siste AS "Siste", mitre AS "MITRE"</query>
        </search>
        <fields>["Mulig angrep","Alvorlighet","Strøm","Avsender","Vinduer","Første","Siste","MITRE"]</fields>
        <!-- Klikk en rad for å åpne siden Detaljer for angrepet, med trafikken 5 min før og etter. -->
        <drilldown>
          <link target="_self">detaljer?form.navn=$row.id|u$&amp;form.strom=$row.velg|u$&amp;form.vis.earliest=$row.vis_fra$&amp;form.vis.latest=$row.vis_til$&amp;form.tid.earliest=$tid.earliest|u$&amp;form.tid.latest=$tid.latest|u$</link>
        </drilldown>
        <option name="count">10</option>
        <option name="wrap">true</option>
        <format type="color" field="Alvorlighet">
          <colorPalette type="map">{"Høy":#DC4E41,"Middels":#F1813F,"Lav":#F8BE34}</colorPalette>
        </format>
      </table>
    </panel>
  </row>
  <!-- Grafene side om side: mulige angrep og rå avvik per minutt. -->
  <row>
    <panel>
      <title>Mulige angrep over tid</title>
      <!-- Antall 10-sekundersvinduer per minutt med hvert mulig angrep. -->
      <chart>
        <search base="avvik">
          <query>diagnoser
| lookup angrepstyper.csv angrep OUTPUT navn
| timechart span=1m cont=false count by navn
| makecontinuous _time span=1m
| fillnull value=0</query>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
    <panel>
      <title>Avvik over tid</title>
      <!-- Avvik per minutt, delt etter type. Se etter en type som dukker opp eller øker plutselig.
           cont=false og makecontinuous fyller bare hull mellom første og siste minutt med data, ikke fra 1970. -->
      <chart>
        <search base="avvik">
          <query>search type="$type$"
| timechart span=1m cont=false count by type
| makecontinuous _time span=1m
| fillnull value=0</query>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
  </row>
  <!-- Antall rader i «Liste over avvik», vist når panelet er lukket. Følger filteret på type. -->
  <search base="avvik">
    <query>search type="$type$"
| stats count AS vinduer by type src_ip dst_ip dst_port len
| stats count AS antall dc(type) AS typer</query>
    <done>
      <set token="n_avvik">$result.antall$</set>
      <set token="n_avvik_typer">$result.typer$</set>
    </done>
  </search>
  <row>
    <panel id="lukkbar_avvik">
      <title>Liste over avvik</title>
      <!-- Én rad per type avvik og strøm, med første og siste gang og hvor mange vinduer det gjelder.
           Målt er det høyeste antallet pakker per 10 s (rate) eller MAC-en som ble sett (feil MAC).
           Lukket til man trykker på pilen ved overskriften (appserver/static/lukkbar.js), som «Mulige angrep». -->
      <html rejects="$vis_avvik$">
        <p class="lukkbar-hint" style="cursor: pointer; margin: 0;">
          <b>$n_avvik$</b> avvik fordelt på <b>$n_avvik_typer$</b> typer. Trykk på pilen for å vise dem.
        </p>
      </html>
      <html depends="$vis_avvik$">
        <p style="margin: 0;">Avvikene diagnosen bygger på, én rad per type og strøm. Klikk en rad for å se trafikken.</p>
      </html>
      <table depends="$vis_avvik$">
        <search base="avvik">
          <query>search type="$type$"
| eval strom=src_ip." → ".dst_ip.":".dst_port." (".len." byte)"
| stats count AS vinduer min(_time) AS forste max(_time) AS siste max(malt) AS malt first(normal) AS normal first(forklaring) AS forklaring by type strom
| sort type -vinduer
| eval velg=strom, vis_fra=forste - 300, vis_til=siste + 300, forste=strftime(forste, "%d.%m %H:%M:%S"), siste=strftime(siste, "%d.%m %H:%M:%S")
| rename type AS "Avvik", strom AS "Strøm", vinduer AS "Vinduer", forste AS "Første", siste AS "Siste", malt AS "Målt", normal AS "Normalt", forklaring AS "Forklaring"</query>
        </search>
        <fields>["Avvik","Strøm","Vinduer","Første","Siste","Målt","Normalt","Forklaring"]</fields>
        <!-- Klikk en rad for å åpne siden Detaljer for strømmen (uten angrep), med trafikken 5 min før og etter. -->
        <drilldown>
          <link target="_self">detaljer?form.strom=$row.velg|u$&amp;form.vis.earliest=$row.vis_fra$&amp;form.vis.latest=$row.vis_til$&amp;form.tid.earliest=$tid.earliest|u$&amp;form.tid.latest=$tid.latest|u$</link>
        </drilldown>
        <option name="count">20</option>
      </table>
    </panel>
  </row>
</dashboard>
