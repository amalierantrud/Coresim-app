<!-- Oversikt over trafikken fra coresim-ws, laget for at et menneske selv skal se avvik.
     Nesten alt vises per minutt over tid: trafikken er svært regelmessig, så normalen blir flate linjer og brudd synes. -->
<dashboard version="1.1">
  <label>Oversikt</label>
  <!-- Tidsvelger. Alle panelene bruker valget gjennom $tid.earliest$ og $tid.latest$. -->
  <fieldset submitButton="false">
    <input type="time" token="tid">
      <label>Tidsrom</label>
      <default>
        <earliest>0</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Pakker per minutt</title>
      <!-- All trafikk samlet. Se etter topper, fall eller brudd i linja. -->
      <chart>
        <search>
          <query>index=anomaly_detection host=coresim-ws.openlab.local
| timechart span=1m count as pakker</query>
          <earliest>$tid.earliest$</earliest>
          <latest>$tid.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.legend.placement">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Pakker per minutt per avsender</title>
      <!-- Én linje per avsender. Se etter en enhet som sender mer, mindre eller slutter helt. -->
      <chart>
        <search>
          <query>index=anomaly_detection host=coresim-ws.openlab.local src_ip=*
| timechart span=1m count by src_ip</query>
          <earliest>$tid.earliest$</earliest>
          <latest>$tid.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.legend.placement">right</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Pakkestørrelser per avsender</title>
      <!-- Én søyle per avsender, delt i farger etter pakkestørrelse (byte). Hver enhet har faste størrelser,
           så en ny farge i en søyle betyr at enheten sender noe den ikke pleier. -->
      <chart>
        <search>
          <query>index=anomaly_detection host=coresim-ws.openlab.local src_ip=*
| chart count over src_ip by len</query>
          <earliest>$tid.earliest$</earliest>
          <latest>$tid.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">right</option>
        <option name="charting.axisTitleX.visibility">collapsed</option>
      </chart>
    </panel>
    <panel>
      <title>Protokoller over tid</title>
      <!-- Feltet protokoll lages i props.conf. Se etter en protokoll som øker, eller en ny som dukker opp. -->
      <chart>
        <search>
          <query>index=anomaly_detection host=coresim-ws.openlab.local protokoll=*
| timechart span=1m count by protokoll</query>
          <earliest>$tid.earliest$</earliest>
          <latest>$tid.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.legend.placement">right</option>
        <option name="charting.fieldColors">{"Annet": 0xDC4E41}</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Mottakere per avsender over tid</title>
      <!-- Antall ulike mottakere hver avsender snakker med per minutt. En plutselig økning kan være skanning. -->
      <chart>
        <search>
          <query>index=anomaly_detection host=coresim-ws.openlab.local src_ip=*
| timechart span=1m dc(dst_ip) by src_ip</query>
          <earliest>$tid.earliest$</earliest>
          <latest>$tid.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.legend.placement">right</option>
      </chart>
    </panel>
    <panel>
      <title>Porter per avsender over tid</title>
      <!-- Antall ulike mottakerporter per avsender per minutt. En plutselig økning kan være skanning. -->
      <chart>
        <search>
          <query>index=anomaly_detection host=coresim-ws.openlab.local src_ip=*
| timechart span=1m dc(dst_port) by src_ip</query>
          <earliest>$tid.earliest$</earliest>
          <latest>$tid.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.legend.placement">right</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Avsendere</title>
      <!-- Én rad per avsender. Se etter nye IP-er (sent første gang) eller IP-er som har forsvunnet (tidlig siste gang). -->
      <table>
        <search>
          <query>index=anomaly_detection host=coresim-ws.openlab.local src_ip=*
| stats min(_time) as forste max(_time) as siste count as pakker by src_ip
| sort forste
| eval forste=strftime(forste, "%Y-%m-%d %H:%M"), siste=strftime(siste, "%Y-%m-%d %H:%M")
| rename src_ip as "Avsender", forste as "Første", siste as "Siste", pakker as "Pakker"</query>
          <earliest>$tid.earliest$</earliest>
          <latest>$tid.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
    <panel>
      <title>Host events per minutt</title>
      <!-- Hendelser fra hosten (indeksen main). Se etter aktivitet samtidig med endringer i nettverket. -->
      <chart>
        <search>
          <query>index=main host=coresim-ws
| timechart span=1m count as hendelser</query>
          <earliest>$tid.earliest$</earliest>
          <latest>$tid.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.legend.placement">none</option>
      </chart>
    </panel>
  </row>
</dashboard>
