<!-- Oversikt over nettverkstrafikken fra coresim-ws. -->
<dashboard version="1.1">
  <label>Oversikt</label>
  <row>
    <panel>
      <title>Antall pakker</title>
      <single>
        <search>
          <query>index=anomaly_detection host=coresim-ws.openlab.local | stats count</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
  </row>
    <row>
    <panel>
      <title>Pakker per sekund per avsender</title>
      <chart>
        <search>
          <query>index=anomaly_detection host=coresim-ws.openlab.local | timechart span=1s count by src_ip</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
    <row>
    <panel>
      <title>Avsendere</title>
      <table>
        <search>
          <query>index=anomaly_detection host=coresim-ws.openlab.local src_ip=*| stats count as pakker dc(dst_ip) as mottakere values(dst_port) as porter values(len) as lengder by src_ip| sort -pakker</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
      </table>
    </panel>
  </row>
</dashboard>